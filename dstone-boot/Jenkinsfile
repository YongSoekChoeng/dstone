// 전제: Jenkins Job의 SCM 체크아웃 범위는 리포지토리 루트 전체(모노레포)여야 한다.
// dstone-boot이 dstone-common에 의존하는 멀티모듈 구조이고, Docker 빌드 컨텍스트도 루트가 필요하기 때문.
pipeline {
    agent any

    environment {
        APP_NAME = 'dstone-boot'
        NAMESPACE = 'dstone'
        REGISTRY = 'localhost:5000'
        IMAGE = "${REGISTRY}/${APP_NAME}"
        KUBECONFIG = '/etc/kind/dev.config'
    }

    stages {
        stage('Checkout') {
            steps {
                echo '====== Git Checkout ======'
                checkout scm
            }
        }

        stage('Build') {
            steps {
                echo '====== Maven Build (Reactor: dstone-common -> dstone-boot) ======'
                sh 'mvn -pl dstone-common,dstone-boot -am -DskipTests clean package'
            }
        }

        stage('Docker Build & Push') {
            steps {
                echo '====== Docker Build & Push (로컬 사설 레지스트리) ======'
                sh """
                    docker build -f dstone-boot/Dockerfile -t ${IMAGE}:${BUILD_NUMBER} -t ${IMAGE}:latest .
                    docker push ${IMAGE}:${BUILD_NUMBER}
                    docker push ${IMAGE}:latest
                """
            }
        }

        stage('Deploy to kind') {
            steps {
                echo '====== Deploy to kind(Kubernetes) ======'
                sh """
                    kubectl apply -f dstone-boot/k8s/namespace.yaml
                    kubectl apply -f dstone-boot/k8s/configmap.yaml
                    kubectl apply -f dstone-boot/k8s/deployment.yaml
                    kubectl apply -f dstone-boot/k8s/service.yaml
                    kubectl set image deployment/${APP_NAME} ${APP_NAME}=${IMAGE}:${BUILD_NUMBER} -n ${NAMESPACE}
                    kubectl rollout status deployment/${APP_NAME} -n ${NAMESPACE} --timeout=120s
                """
            }
        }

        stage('Health Check') {
            steps {
                echo '====== Health Check ======'
                sh """
                    kubectl get pods -n ${NAMESPACE} -l app=${APP_NAME}
                    kubectl logs -n ${NAMESPACE} deploy/${APP_NAME} --tail=30
                """
            }
        }
    }

    post {
        success {
            echo '====== Deployment Successful ======'
        }
        failure {
            echo '====== Deployment Failed ======'
            sh 'kubectl logs -n ${NAMESPACE} deploy/${APP_NAME} --tail=100 || true'
        }
        always {
            echo '====== Cleanup ======'
            deleteDir()
        }
    }
}
