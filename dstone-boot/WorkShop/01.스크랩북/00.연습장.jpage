net.dstone.common.utils.DateUtil.stopWatchStart("연습장");try {		String baseRoot = "D:/Temp/업그레이드";	String oldVer = "0403";	String newVer = "0418";	String oldPath = baseRoot + "/" + ".m2["+oldVer+"]";	String newPath = baseRoot + "/" + ".m2["+newVer+"]";	String netPath = baseRoot + "/" + ".m2[신규건("+newVer+"-"+oldVer+")]";	String[] oldFiles = null;	String[] newFiles = null;		java.util.List<String> oldList = new java.util.ArrayList<String>();	java.util.List<String> newList = new java.util.ArrayList<String>();	java.util.List<String> netList = new java.util.ArrayList<String>();		StringBuffer oldBuffer = new StringBuffer();	StringBuffer newBuffer = new StringBuffer();	StringBuffer netBuffer = new StringBuffer();	/*****************************************************/	oldFiles = net.dstone.common.utils.FileUtil.readFileListAll(oldPath);	for(String file : oldFiles){		if( (file.endsWith(".jar") || file.endsWith(".pom")) && file.indexOf("-sources.") == -1 ){			file = net.dstone.common.utils.StringUtil.replace(file, oldPath, "");			oldList.add(file);			oldBuffer.append(file).append("\n");		}else{			net.dstone.common.utils.FileUtil.deleteFile(file);		}	}	net.dstone.common.utils.FileUtil.writeFile(oldPath, "리스트.txt", oldBuffer.toString());	/*****************************************************/	newFiles = net.dstone.common.utils.FileUtil.readFileListAll(newPath);	for(String file : newFiles){		if( (file.endsWith(".jar") || file.endsWith(".pom")) && file.indexOf("-sources.") == -1 ){			file = net.dstone.common.utils.StringUtil.replace(file, newPath, "");			newList.add(file);			newBuffer.append(file).append("\n");		}else{			net.dstone.common.utils.FileUtil.deleteFile(file);		}	}	net.dstone.common.utils.FileUtil.writeFile(newPath, "리스트.txt", newBuffer.toString());		/*****************************************************/	net.dstone.common.utils.FileUtil.deleteDir(netPath);	net.dstone.common.utils.FileUtil.makeDir(netPath);	for(String file : newList){		if( !oldList.contains(file) ){			netList.add(file);			netBuffer.append(file).append("\n");		}	}	net.dstone.common.utils.FileUtil.writeFile(netPath, "리스트.txt", netBuffer.toString());	System.out.println("oldList.size()====>>["+oldList.size()+"]");	System.out.println("newList.size()====>>["+newList.size()+"]");	System.out.println("netList.size()====>>["+netList.size()+"]");		System.out.println("||===========================================" + " NetList Start !!! " + "===========================================||");	for(String file : netList){		String newfile = newPath + file;		String netfile = netPath + file;		System.out.println("netList["+netfile+"]");		net.dstone.common.utils.FileUtil.copyFile(newfile, netfile);	}	System.out.println("||===========================================" + " NetList End !!! " + "===========================================||");}catch(Exception e){	e.printStackTrace();}finally{	net.dstone.common.utils.DateUtil.stopWatchEnd("연습장");}