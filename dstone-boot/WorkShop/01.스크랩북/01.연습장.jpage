/*****************************************************//*****************************************************/net.dstone.common.utils.DateUtil.stopWatchStart("01.연습장");try {		String basePath = "D:/Swap/현대해상-클라우드컨설팅";		String[] files = net.dstone.common.utils.FileUtil.readFileListAll(basePath);		for(String file : files){		String newFile = "";		if(file.endsWith(".XLS_Copy") || file.endsWith(".xls_Copy")){			String filePath = net.dstone.common.utils.FileUtil.getFilePath(file);			newFile = filePath + ".xls";		}else if(file.endsWith(".XLSX_Copy") || file.endsWith(".xlsx_Copy")){			String filePath = net.dstone.common.utils.FileUtil.getFilePath(file);			newFile = filePath + ".xlsx";		}		if( !"".equals(newFile) ){			System.out.println( "file["+file+"] ==>> newFile["+newFile+"]" );		}	}    } catch (Exception e) {	e.printStackTrace();} finally{	net.dstone.common.utils.DateUtil.stopWatchEnd("01.연습장");}