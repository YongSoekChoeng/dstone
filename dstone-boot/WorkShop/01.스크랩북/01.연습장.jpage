/*****************************************************//*****************************************************/net.dstone.common.utils.DateUtil.stopWatchStart("01.연습장");try {		String basePath = "D:\\AppHome\\framework\\dstone\\dstone-ai-engine\\src\\main\\resources\\agents\\sample";	basePath = net.dstone.common.utils.StringUtil.replace(basePath, "\\", "/");		String[] files = net.dstone.common.utils.FileUtil.readFileListAll(basePath);	java.util.HashMap<String, String> replaceMap = new java.util.HashMap<String, String>();		for(String file : files){		String filePath = net.dstone.common.utils.FileUtil.getFilePath(file);		String fileName = net.dstone.common.utils.FileUtil.getFileName(file, false);		String fileConts = net.dstone.common.utils.FileUtil.readFile(file);				String newFileName = "sample-" + fileName;		String newFile =  filePath + "/" + newFileName + ".yml";		String newFileConts = net.dstone.common.utils.StringUtil.replace(fileConts, fileName, newFileName);		System.out.println( "file["+file+"] ==>> newFile["+newFile+"]" );				replaceMap.put(fileName, newFileName);				net.dstone.common.utils.FileUtil.moveFile(file, newFile);	}	files = net.dstone.common.utils.FileUtil.readFileListAll(basePath);	for(String file : files){		String filePath = net.dstone.common.utils.FileUtil.getFilePath(file);		String fileName = net.dstone.common.utils.FileUtil.getFileName(file, true);		String fileConts = net.dstone.common.utils.FileUtil.readFile(file);		fileConts = net.dstone.common.utils.StringUtil.replace(fileConts, replaceMap);				System.out.println( "filePath["+filePath+"] ==>> fileName["+fileName+"]" );		net.dstone.common.utils.FileUtil.writeFile(filePath, fileName, fileConts);	}	    } catch (Exception e) {	e.printStackTrace();} finally{	net.dstone.common.utils.DateUtil.stopWatchEnd("01.연습장");}