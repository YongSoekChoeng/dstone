<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>net.dstone</groupId>
		<artifactId>dstone</artifactId>
		<version>1.0.0-SNAPSHOT</version>
	</parent>
	<artifactId>dstone-ai-engine</artifactId>

	<properties>
		<java.version>21</java.version>
		<log4j.version>2.24.3</log4j.version>
		<!-- 루트 pom의 spring-boot.version이 4.x(Spring Framework 7)로 올라감에 따라
		     Spring AI도 그에 맞는 2.x 라인으로 함께 올린다. -->
		<spring-ai.version>2.0.1</spring-ai.version>
		<!-- Spring AI 2.0.1(spring-ai-client-chat)이 쓰는 버전과 같게 둔다. Spring AI를 올리면 함께 확인한다. -->
		<json-schema-validator.version>3.0.1</json-schema-validator.version>
		<jackson-jq.version>1.6.5</jackson-jq.version>
	</properties>

	<repositories>
        <repository>
            <id>central</id>
            <name>Central Repository</name>
            <url>https://repo.maven.apache.org/maven2</url>
            <layout>default</layout>
			<releases>
				<enabled>true</enabled>
			</releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.ai</groupId>
				<artifactId>spring-ai-bom</artifactId>
				<version>${spring-ai.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<!-- dstone-common이 commons-io 2.15.1을 직접 명시하는데, RAG(Phase 2)의
			     spring-ai-tika-document-reader가 끌어오는 commons-compress 1.28.0은
			     org.apache.commons.io.input.ChecksumInputStream(commons-io 2.16.0에서 추가)을 요구한다.
			     Maven의 "nearest wins" 규칙상 dstone-common의 직접 의존성이 이겨서 문서 적재 시
			     NoClassDefFoundError로 죽는다 - 이 모듈에서만 최신 버전으로 올려서 해결한다. -->
			<dependency>
				<groupId>commons-io</groupId>
				<artifactId>commons-io</artifactId>
				<version>2.20.0</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>

		<!-- dstone-common (spring-boot-starter-web/security/log4j2/redis/kafka/amqp/datasource 등을 이미 전이의존성으로 포함) -->
		<dependency>
		    <groupId>net.dstone</groupId>
		    <artifactId>dstone-common</artifactId>
		</dependency>

		<!-- Actuator(k8s liveness/readiness probe) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
			<exclusions>
				<exclusion>
					<groupId>org.springframework.boot</groupId>
					<artifactId>spring-boot-starter-logging</artifactId>
				</exclusion>
			</exclusions>
		</dependency>

		<!-- Spring AI Model Gateway(Phase 1): provider별 starter를 모두 클래스패스에 올려두고,
		     application.yml의 spring.ai.model.chat 값(net.dstone.ai.gateway.AiProvider) 하나로
		     실제 활성화되는 ChatModel/ChatClient를 교체한다(각 starter의 자동설정이
		     spring.ai.model.chat=<provider명> 조건부로 동작 — 코드 변경 불필요).
		     local(vLLM)은 OpenAI 호환 API이므로 openai starter를 base-url만 바꿔 재사용하고,
		     local(Ollama)은 ollama starter를 그대로 사용한다.
		     azure-openai는 Spring AI 2.x에서 chat model provider로는 완전히 제거되어
		     (spring-ai-starter-model-azure-openai가 2.0.0-M4 이후 더 이상 배포되지 않음,
		     Azure는 vector-store 용도만 남음) 더 이상 지원 목록에 없다. -->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-starter-model-anthropic</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-starter-model-openai</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-starter-model-ollama</artifactId>
		</dependency>

		<!-- JSON Schema 검사(Agent/Workflow의 input/output 계약, common.schema.JsonSchemas).
		     spring-ai-client-chat이 이미 끌어오는 라이브러리지만, 엔진 코드가 직접 쓰므로 명시해 둔다.
		     버전은 Spring AI가 쓰는 것과 같게 맞춘다(properties의 json-schema-validator.version). -->
		<dependency>
			<groupId>com.networknt</groupId>
			<artifactId>json-schema-validator</artifactId>
			<version>${json-schema-validator.version}</version>
			<exclusions>
				<!-- Spring AI와 같은 제외. YAML 입력은 쓰지 않는다(YAML은 SnakeYAML로 먼저 맵으로 읽은 뒤 JSON 글자로 검사한다). -->
				<exclusion>
					<groupId>tools.jackson.dataformat</groupId>
					<artifactId>jackson-dataformat-yaml</artifactId>
				</exclusion>
			</exclusions>
		</dependency>

		<!-- Workflow YAML의 "${ jq 식 }" 표현식을 해석합니다(common.schema.ExpressionEvaluator).
		     엔진 코드가 쓰는 Jackson 2(com.fasterxml) JsonNode 위에서 동작하는 1.x 라인을 씁니다. -->
		<dependency>
			<groupId>net.thisptr</groupId>
			<artifactId>jackson-jq</artifactId>
			<version>${jackson-jq.version}</version>
		</dependency>

		<!-- RAG(Phase 2): pgvector 기반 VectorStore. DataSource(spring.datasource.*)와 EmbeddingModel
		     (spring.ai.model.embedding) 빈이 둘 다 있어야 자동설정된다. DataSource 자체는 dstone-common이
		     이미 제공하는 HikariCP/postgresql-driver/log4jdbc로 표준 Spring Boot 단일 datasource
		     자동설정(spring.datasource.*)을 그대로 쓴다(dstone-boot처럼 여러 datasource가 아니라 하나뿐이라
		     별도 ConfigDatasource 클래스 없이도 충분하다). -->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-starter-vector-store-pgvector</artifactId>
		</dependency>
		<!-- RAG 검색 체인(RetrievalAugmentationAdvisor/VectorStoreDocumentRetriever/ContextualQueryAugmenter) -
		     검색된 문서를 프롬프트에 끼워넣는 ChatClient Advisor를 조립하는 파이프라인이다(common.rag.RagRetrievalChain). -->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-rag</artifactId>
		</dependency>

		<!-- MCP 클라이언트(Phase 4): resources/mcp/*.yml로 정의된 외부 MCP 서버에 접속해 그 서버의 Tool을
		     끌어온다(common.config.ConfigMcp). STDIO/SSE 트랜스포트 둘 다 이 starter 하나로 커버된다. -->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-starter-mcp-client</artifactId>
		</dependency>

		<!-- RAG(Phase 2) 문서 적재: Tika 하나로 PDF/DOCX/PPTX/HTML/TXT 등 대부분의 SI 문서 포맷을 커버한다. -->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-tika-document-reader</artifactId>
		</dependency>

		<!-- Lombok -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<scope>provided</scope>
		</dependency>

		<!-- Test -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>

	</dependencies>

	<build>
		<finalName>${project.artifactId}</finalName>
		<resources>
			<resource>
				<directory>conf</directory>
				<targetPath>${project.basedir}/target/classes</targetPath>
				<includes>
					<include>*.properties</include>
				</includes>
			</resource>
			<resource>
				<directory>src/main/java</directory>
				<targetPath>${project.basedir}/target/classes</targetPath>
				<includes>
					<include>**/*.xml</include>
				</includes>
			</resource>
			<resource>
				<directory>src/main/resources</directory>
				<targetPath>${project.basedir}/target/classes</targetPath>
				<excludes>
					<exclude>**/*.java</exclude>
				</excludes>
				<filtering>true</filtering>
			</resource>
		</resources>
		<plugins>

			<!-- 컴파일을 위한 플러그인 -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<source>${java.version}</source>
					<target>${java.version}</target>
					<showWarnings>true</showWarnings>
					<showDeprecation>true</showDeprecation>
					<encoding>UTF-8</encoding>
					<parameters>true</parameters>
				</configuration>
			</plugin>

			<!-- JAR (스프링부트형식-BOOT-INF포함구조-으로) 패키징을 위한 플러그인 -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<includeSystemScope>true</includeSystemScope>
					<mainClass>net.dstone.ai.DstoneAiEngineApplication</mainClass>
					<!-- JDK17 이후 보안강화로 발생하는 Nested jar 문제에 대한 처리(dstone-boot과 동일 조치). -->
					<requiresUnpack>
						<dependency>
							<groupId>org.bouncycastle</groupId>
							<artifactId>bcprov-jdk18on</artifactId>
						</dependency>
					</requiresUnpack>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>repackage</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

		</plugins>
	</build>

</project>
