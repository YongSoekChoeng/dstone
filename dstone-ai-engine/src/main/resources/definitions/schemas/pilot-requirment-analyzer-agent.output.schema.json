{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pilot-requirment-analyzer-agent output",
  "type": "object",
  "properties": {
    "file": {
      "type": "string",
      "description": "저장한 요구사항 정의서의 절대경로"
    },
    "summary": {
      "type": "string",
      "description": "요구사항 핵심 요약(3~5줄)"
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "확인 필요 질문(없으면 빈 배열)"
    }
  },
  "required": [
    "file",
    "summary"
  ]
}
