{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pilot-newdev-doc-writer-agent input",
  "type": "object",
  "properties": {
    "document": {
      "type": "string",
      "enum": [
        "요구사항정의서",
        "영향도분석서",
        "설계서",
        "구현결과"
      ],
      "description": "쓸 문서의 종류"
    },
    "filePath": {
      "type": "string",
      "description": "문서를 저장할 파일의 절대경로"
    },
    "data": {
      "type": "object",
      "description": "문서에 옮겨 적을 데이터(앞 단계의 결과)"
    }
  },
  "required": [
    "document",
    "filePath",
    "data"
  ]
}
