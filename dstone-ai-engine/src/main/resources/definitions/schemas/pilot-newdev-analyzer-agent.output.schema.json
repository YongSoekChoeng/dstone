{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pilot-newdev-analyzer-agent output",
  "type": "object",
  "properties": {
    "background": {
      "type": "string",
      "description": "배경과 목적(3줄 이내)"
    },
    "scope": {
      "type": "array",
      "description": "요청서에 적힌 메뉴/기능. 하나도 빼지 않는다",
      "items": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string",
            "description": "요청서의 메뉴/기능"
          },
          "frs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "이 메뉴/기능을 다루는 FR 번호"
          }
        },
        "required": [
          "item",
          "frs"
        ]
      }
    },
    "requirements": {
      "type": "array",
      "description": "기능 요구사항",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "FR 번호. FR-01, FR-02 ..."
          },
          "title": {
            "type": "string",
            "description": "요구사항 한 줄"
          },
          "given": {
            "type": "string",
            "description": "인수 조건의 전제"
          },
          "when": {
            "type": "string",
            "description": "인수 조건의 사용자 행동"
          },
          "then": {
            "type": "string",
            "description": "인수 조건의 기대 결과(화면에서 확인할 수 있는 것)"
          }
        },
        "required": [
          "id",
          "title",
          "then"
        ]
      }
    },
    "nonFunctional": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "비기능 요구사항(없으면 빈 배열)"
    },
    "outOfScope": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "범위 제외 항목(없으면 빈 배열)"
    },
    "layers": {
      "type": "array",
      "description": "참고 구현의 층별 판단",
      "items": {
        "type": "object",
        "properties": {
          "layer": {
            "type": "string",
            "description": "화면 / Controller / Service / DAO / VO / 쿼리 파일 / 테이블 / 메뉴 등록 / 설정 등록"
          },
          "referencePath": {
            "type": "string",
            "description": "참고 구현에서 이 층에 해당하는 파일의 절대경로"
          },
          "symbol": {
            "type": "string",
            "description": "참고 구현의 클래스.메서드, 쿼리ID, 테이블명"
          },
          "decision": {
            "type": "string",
            "enum": [
              "신규",
              "수정",
              "필요 없음"
            ]
          },
          "reason": {
            "type": "string",
            "description": "그렇게 정한 이유 한 줄"
          }
        },
        "required": [
          "layer",
          "decision"
        ]
      }
    },
    "targets": {
      "type": "array",
      "description": "변경 대상 파일. 파일 하나에 한 건",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "만들거나 고칠 파일의 절대경로"
          },
          "changeType": {
            "type": "string",
            "enum": [
              "신규",
              "수정"
            ]
          },
          "referencePath": {
            "type": "string",
            "description": "신규 파일이 본뜰 참고 파일의 절대경로. 본뜰 파일이 없으면 빈 글자"
          },
          "change": {
            "type": "string",
            "description": "무엇을 만들거나 바꾸는지. 참고 구현과 달라지는 점(바뀌는 이름, 빼는 메서드/쿼리/화면 요소)을 함께 적는다"
          },
          "frs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "이 변경이 해결하는 FR 번호"
          }
        },
        "required": [
          "path",
          "changeType",
          "change",
          "frs"
        ]
      }
    },
    "sharedNames": {
      "type": "array",
      "description": "여러 파일이 함께 쓰는 이름. 파일별 설계가 이 이름을 그대로 쓴다",
      "items": {
        "type": "object",
        "properties": {
          "what": {
            "type": "string",
            "description": "무엇의 이름인지(테이블, 컬럼, URL, 쿼리 namespace, 쿼리ID, 패키지, 클래스, 메서드, 화면 파일)"
          },
          "name": {
            "type": "string",
            "description": "새 기능에서 쓸 이름"
          },
          "from": {
            "type": "string",
            "description": "참고 구현에서 이에 해당하는 이름. 없으면 빈 글자"
          }
        },
        "required": [
          "what",
          "name"
        ]
      }
    },
    "impacts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "영향 받는 기존 기능, 호출자, DB 객체(없으면 빈 배열)"
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "위험 요소와 회귀 테스트가 필요한 기존 기능(없으면 빈 배열)"
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "사람만 답할 수 있는 질문(없으면 빈 배열)"
    }
  },
  "required": [
    "scope",
    "requirements",
    "layers",
    "targets",
    "sharedNames"
  ]
}
